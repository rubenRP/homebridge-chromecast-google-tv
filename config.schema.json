{
  "pluginAlias": "HomebridgeChromecastGoogleTV",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Add your Chromecast with Google TV.",
  "footerDisplay": "If you need more info, check out the <a href='https://github.com/rubenRP/homebridge-chromecast-google-tv/blob/main/README.md'>ReadMe</a>",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Google TV"
      },
      "category": {
        "title": "Device Category",
        "description": "Choose how you want the device displayed in HomeKit. This affects the icon shown in Apple Home. Does not impact functionality.",
        "type": "string",
        "default": "TELEVISION",
        "oneOf": [
          {
            "title": "Television",
            "enum": ["TELEVISION"]
          },
          {
            "title": "Streaming Stick",
            "enum": ["TV_STREAMING_STICK"]
          },
          {
            "title": "Set Top Box",
            "enum": ["TV_SET_TOP_BOX"]
          },
          {
            "title": "Apple TV",
            "enum": ["APPLE_TV"]
          }
        ]
      }
    },
    "required": ["name"]
  }
}
