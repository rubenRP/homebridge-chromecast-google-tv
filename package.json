    "homebridge-lib": "^7.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "homebridge": "^2.0.0-beta.0",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  },
  "directories": {
    "test": "test"
  },
  "author": "Ruben Rodriguez",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/rubenRP/homebridge-chromecast-google-tv#readme"
