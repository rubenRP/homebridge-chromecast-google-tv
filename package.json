{
  "displayName": "Homebridge Chromecast with Google TV",
  "name": "homebridge-chromecast-google-tv",
  "type": "module",
  "private": true,
  "version": "2.0.0",
  "description": "Integration with google TV to control it with HomeKit and create integrations",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rubenRP/homebridge-chromecast-google-tv.git"
  },
  "bugs": {
    "url": "https://github.com/rubenRP/homebridge-chromecast-google-tv/issues"
  },
  "engines": {
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "keywords": [
    "homebridge-plugin",
    "chromecast",
    "google tv",
    "homekit"
  ],
  "dependencies": {
    "homebridge-lib": "^7.1.4",
    "castv2-client": "^1.2.0",
    "mdns": "^2.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "homebridge": "^2.0.0-beta.0",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
