{
  "displayName": "Homebridge Chromecast with Google TV",
  "name": "@rubenrp/homebridge-chromecast-google-tv",
  "type": "module",
  "private": true,
  "version": "2.0.0",
  "description": "Integration with google TV to control it with HomeKit and create integrations",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubenRP/homebridge-chromecast-google-tv.git"
  },
  "bugs": {
    "url": "https://github.com/rubenRP/homebridge-chromecast-google-tv/issues"
  },
  "engines": {
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
